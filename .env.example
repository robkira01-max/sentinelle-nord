# Flask
FLASK_SECRET_KEY=change-me-in-prod
FLASK_ENV=development
FLASK_HOST=127.0.0.1
FLASK_PORT=5000

# Database
DATABASE_URL=sqlite:///osint.db

# Cache
CACHE_TTL=3600

# API Keys
URLSCAN_API_KEY=
SHODAN_API_KEY=
CENSYS_API_ID=
CENSYS_API_SECRET=

# Collectors activables
ENABLE_DNS=true
ENABLE_HTTP=true
ENABLE_WHOIS=true
ENABLE_URLSCAN=false
ENABLE_SHODAN=false
ENABLE_CENSYS=false
ENABLE_CVE=true

# CVE : keyword explicite (optionnel, fallback = premier label du domaine)
CVE_KEYWORD=

# Arctic pipeline
AISHUB_API_KEY=         # https://www.aishub.net/ (inscription gratuite)

# Scheduler
SCHEDULER_ENABLED=true  # false pour désactiver le scheduler en dev
